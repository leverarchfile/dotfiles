// ---------------------------------------------------------------------
// OUTPUTS — deliberately empty.
//
// kanshi handles mode/scale/position/enable for eDP-1 and both docks.
// Anything written here risks niri#676. Leave this block commented out.
// ---------------------------------------------------------------------

// ---------------------------------------------------------------------
// INPUT
// ---------------------------------------------------------------------
input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 250
        repeat-rate 50
    }

    touchpad {
        tap
        drag true
        natural-scroll
        dwt                          // disable-while-typing
        accel-profile "adaptive"
        accel-speed 0.30
        scroll-factor 1.5
    }

    focus-follows-mouse
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 5000
}

// ---------------------------------------------------------------------
// LAYOUT
// ---------------------------------------------------------------------
layout {
    gaps 6

    default-column-width { proportion 0.5; }

    border {
        on
        width 2
        active-color "#ebdbb2"
        inactive-color "#928374"
    }

    focus-ring {
        off
    }

    background-color "#282828"

}

// ---------------------------------------------------------------------
// WORKSPACES
// ---------------------------------------------------------------------

prefer-no-csd

screenshot-path "~/pictures/screenshots/%Y-%m-%d-%H%M%S.png"

hotkey-overlay {
    skip-at-startup
}

// ---------------------------------------------------------------------
// WINDOW RULES
// ---------------------------------------------------------------------
window-rule {
    match title="emacs-window-popup"
    match title="emacs-float"
    open-floating true
}

window-rule {
    match app-id="xdg-desktop-portal-gtk"
    open-floating true
    default-floating-position x=200 y=50 relative-to="top-left"
}

// ---------------------------------------------------------------------
// ENVIRONMENT
//
// Note: these do NOT reach apps started by systemd user units.
// GTK_IM_MODULE belongs in .zprofile if it needs to apply everywhere
// (plan, "Compose key and dead keys").
// ---------------------------------------------------------------------
environment {
    XDG_CURRENT_DESKTOP "niri"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

// ---------------------------------------------------------------------
// STARTUP
// ---------------------------------------------------------------------
spawn-at-startup "kanshi"
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "udiskie"
spawn-at-startup "foot" "--server"
spawn-sh-at-startup "kmonad ~/.config/kmonad/config.kbd"
spawn-at-startup "librepods" "--no-tray"
spawn-at-startup "wl-clip-persist" "--clipboard" "regular"
spawn-sh-at-startup "wl-paste --type text  --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
spawn-at-startup "swayidle" "-w" \
    "timeout" "300" "lock" \
    "timeout" "600" "niri msg action power-off-monitors" \
    "resume"  "niri msg action power-on-monitors" \
    "before-sleep" "lock"

// niri_tilemod: auto-stacks windows into columns, N per column.
// From https://github.com/heyoeyo/niri_tweaks
// kanhsi handles this
// spawn-sh-at-startup "niri_tilemod -n 3 >/tmp/tilemod.log 2>&1"

// NOT HERE: nm-applet and the polkit agent. Both have files in
// /etc/xdg/autostart/, and niri (unlike River) processes that directory,
// so listing them here would start each one twice.

// ---------------------------------------------------------------------
// KEYBINDINGS
// ---------------------------------------------------------------------
recent-windows {
      binds {
          Alt+Tab         { next-window; }
          Alt+Shift+Tab   { previous-window; }

          Mod+A { next-window scope="workspace"; }
      }
    }

binds {
    Mod+Slash { show-hotkey-overlay; }

    // ---- window management ----
    Mod+Escape       { close-window; }

    Mod+Tab          { toggle-overview; }
    Mod+Shift+Tab    { toggle-window-floating; }

    // niri_maximize: maximize that restores position
    // From https://github.com/heyoeyo/niri_tweaks
    Mod+F            { spawn "niri_maximize" "maximize-window-to-edges"; }
    Mod+Shift+F      { spawn "niri_maximize" "fullscreen-window"; }
  
    // Promote focused window to master position.
    Mod+Shift+A { move-column-to-first; }

    // ---- focus (h/j/k/l) ----
    Mod+H { focus-column-left; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+L { focus-column-right; }

    // ---- move (Shift) ----
    // niri_overview_bind: to reorder workspaces in overview mode 
    // From https://github.com/heyoeyo/niri_tweaks
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { spawn "niri_overview_bind" "move-workspace-down" "move-window-down"; }
    Mod+Shift+K { spawn "niri_overview_bind" "move-workspace-up" "move-window-up"; }
    Mod+Shift+L { move-column-right; }

    // Move focused window out of its column into its own (or pull the
    // neighbouring column in). Undoes tilemod's auto-stacking per-window.
    Mod+Ctrl+L { spawn-sh "niri msg action consume-or-expel-window-right; niri msg action set-column-width 100%"; }
    Mod+Ctrl+H { spawn-sh "niri msg action set-column-width 50%"; }
    Mod+Ctrl+J { consume-or-expel-window-left; }

    // ---- launchers ----
    // NB: `spawn` does not expand $TERMINAL. footclient needs `foot --server`.
    Mod+Return    { spawn "footclient"; }
    Mod+S         { spawn "screenshot"; }
    Mod+D         { spawn "tofi-drun" "--drun-launch=true"; }
    Mod+G         { spawn "footclient" "lf"; }
    Mod+X         { spawn "system_state"; }
    Mod+C         { spawn "clipboard"; }
    Mod+B         { spawn "firefox"; }
    Mod+M         { spawn "bookmark" "add"; }
    Mod+V         { spawn "bookmark" "open"; }
    Mod+Semicolon { spawn-sh "emacsclient -c 2>/dev/null || emacs"; }
    Mod+Minus     { spawn "password_menu"; }

    Mod+Shift+S { spawn-sh "wl-paste -t image | swappy -f -"; }
    Mod+Shift+C { spawn "colour-picker"; }
    Mod+Shift+Z { spawn "bt_toggle"; }
    Mod+Shift+M { spawn "tailscale_mullvad_select"; }
    Mod+Shift+V { spawn "define"; }
    Mod+Shift+B { spawn "reload-waybar"; }

    Mod+Shift+D { spawn "emacsclient" "-e" "(prot-window-popup-org-capture)"; }
    Mod+Shift+G { spawn "emacsclient" "-e" "(thanos/type)"; }

    // ---- workspaces ----
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // ---- monitors ----
    Mod+Period { focus-monitor-next; }
    Mod+Comma  { focus-monitor-previous; }
    Mod+Shift+Period { move-column-to-monitor-next; }
    Mod+Shift+Comma  { move-column-to-monitor-previous; }

    // ---- media keys ----
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "volume" "up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "volume" "down"; }
    XF86AudioMute         allow-when-locked=true { spawn "volume" "mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightness" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightness" "down"; }

    // ---- session ----
    Mod+Ctrl+Z { quit; }
}
