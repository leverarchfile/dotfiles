#!/bin/sh

# Calculator with fuzzel and qalc.

while expr=$(printf '' | fuzzel --dmenu --lines 1 --width 50 --prompt "Calc: " --placeholder "$placeholder"); do
  if [ -z "$expr" ]; then
    [ -n "$ans" ] && printf '%s' "$ans" | wl-copy
    exit 0
  fi
  ans=$(qalc -t -- "$expr")
  placeholder="$expr = $ans"
done
