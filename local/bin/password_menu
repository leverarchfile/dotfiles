#!/bin/sh

passwords=$(find "$PASSWORD_STORE_DIR" -name "*.gpg" -printf "%f\n" | sed 's/\.gpg$//')

password=$(echo "$passwords" | sort | fuzzel -w 30 -di) || exit 0

secret=$(pass show "$password" 2>/dev/null | head -n 1)
[ -n "$secret" ] || exit 1

printf '%s' "$secret" | wl-copy --sensitive
notify-send "Copied $password" "Will clear in 45 seconds"

(
    sleep 45
    [ "$(wl-paste -n 2>/dev/null)" = "$secret" ] && wl-copy --clear
    cliphist delete-query "$secret"
) &
