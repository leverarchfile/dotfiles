#!/bin/sh

# Join the selected text into one paragraph and paste it over the selection.
# Select one paragraph at a time.

text=$(wl-paste --primary 2>/dev/null) || exit 0
[ -n "$text" ] || exit 0

prev=$(wl-paste --no-newline 2>/dev/null)

printf '%s' "$text" | tr -s '[:space:]' ' ' | sed 's/ $//' | wl-copy --sensitive

wtype -M ctrl v -m ctrl
sleep 0.2
printf '%s' "$prev" | wl-copy --sensitive
