#!/usr/bin/env python3

import re, subprocess, time

def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw).stdout

LIST_ITEM = re.compile(r"^\s*([-*•]|\d+[.)])\s+")

text = run(["wl-paste", "--primary", "--no-newline"])
if text:
    out = []
    for para in re.split(r"\n\s*\n", text):
        lines = [l.strip() for l in para.split("\n")]
        joined = []
        for line in lines:
            if not joined or LIST_ITEM.match(line):
                joined.append(line)
            else:
                joined[-1] += " " + line
        out.append("\n".join(joined))
    text = re.sub(r"[ \t]{2,}", " ", "\n\n".join(out))
    previous = run(["wl-paste", "--no-newline"])
    subprocess.run(["wl-copy", "--sensitive"], input=text, text=True)
    subprocess.run(["wtype", "-M", "ctrl", "v", "-m", "ctrl"])
    time.sleep(0.2)
    subprocess.run(["wl-copy", "--sensitive"], input=previous, text=True)
